# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.kavyamoment.com

# /admin sign-in. ADMIN_SECRET signs the session cookie (use a long random string).
ADMIN_PASSWORD=change-me
ADMIN_SECRET=replace-with-a-long-random-string

# Optional: WhatsApp number (digits only, with country code) for "Choose This Template".
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: where templates.json and uploads are stored (default ./storage).
# STORAGE_DIR=/var/data/kavyamoment
